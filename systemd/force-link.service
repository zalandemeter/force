[Unit]
Description=Force direct link (reaches remotes over QUIC when it can, SPEC §56.2)
Documentation=file://%h/.local/share/force/app/SPEC.md
# only while the live release has the direct link: an older one switched to later (a rollback) has no force-link,
# or no `force link-daemon`, and the unit then stays down instead of failing over and over (SPEC §12)
ConditionPathExists=%h/.local/share/force/app/share/bin/force-link
ConditionPathExists=%h/.local/share/force/app/force/link.py

[Service]
Type=simple
Environment=PATH=%h/.local/share/force/app/share/tmux-bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/force link-daemon
Restart=always
RestartSec=3
# `force link-daemon` exits 0 when the directLink setting is off (or force-link is missing): then it stays down.
# 2 is a usage error (a release without the command): restarting would not help either
RestartPreventExitStatus=0 2

[Install]
WantedBy=default.target
