\"" "#{?#{==:#{@force_glyphs},rich},#[fg=#d97757]#[default]  ,}Restart" "x" "run-shell -b \"#{@force_app}/share/ui-key.sh '#{socket_path}' '#{window_id}' restart\"" "#{?#{==:#{@force_glyphs},rich},#[fg=#d97757]#[default]  ,}Archive…" "a" "display-popup -e \"FORCE_HOST=#{@force_host}\" -e \"FORCE_CLIENT=#{@force_nested}\" -e \"FORCE_SESSION=#{@force_session}\" -e \"FORCE_GLYPHS=#{@force_glyphs}\" -E -w 64 -h 13 \"$FORCE_BIN dialog archive '#{@force_session}'\"" "#{?#{==:#{@force_glyphs},rich},#[fg=#d97757]#[default]  ,}Archived sessions…" "A" "if-shell -F \"#{@force_overlay}\" \"run-shell -b '$FORCE_BIN ui-main --window #{window_id} --wait --dialog archived --client #{client_name}'\" \"display-popup -e \\\"FORCE_HOST=#{@force_host}\\\" -e \\\"FORCE_CLIENT=#{@force_nested}\\\" -e \\\"FORCE_SESSION=#{@force_session}\\\" -e \\\"FORCE_GLYPHS=#{@force_glyphs}\\\" -E -w 72 -h 21 \\\"$FORCE_BIN dialog archived\\\"\"" "#{?#{==:#{@force_glyphs},rich},#[fg=#d97757]#[default]  ,}Ask Chuck…" "?" "display-popup -e \"FORCE_HOST=#{@force_host}\" -e \"FORCE_CLIENT=#{@force_nested}\" -e \"FORCE_SESSION=#{@force_session}\" -e \"FORCE_GLYPHS=#{@force_glyphs}\" -e \"FORCE_WINDOW=#{window_id}\" -b rounded -S \"fg=#4e4e4e,bg=#212121\" -s \"bg=#212121\" -E -w 72 -h 17 \"$FORCE_BIN support --ui\"" "#{?#{==:#{@force_glyphs},rich},#[fg=#d97757]#[default]  ,}Keys…" "k" "display-popup -b rounded -S \"fg=#4e4e4e,bg=#212121\" -s \"bg=#212121\" -E -w 72 -h 20 \"#{@force_app}/share/show-help.sh\"" "#{?#{==:#{@force_glyphs},rich},#[fg=#d97757]#[default]  ,}Quit (sessions keep running)" "q" "detach-client"
} {
display-message -d 4000 " the terminal is too short for the Force menu (14 rows) "
}
}
}
}
